# Discord Bot Token (Lấy từ Discord Developer Portal)
DISCORD_BOT_TOKEN=your_bot_token_here

# Channel ID của kênh #daily-stand-up (Đã lấy từ ảnh của bạn)
CHANNEL_ID=1504851139441459241

# Channel ID của kênh #monitoring (nhận báo cáo sức khỏe server, cảnh báo bot & hạ tầng)
MONITORING_CHANNEL_ID=1564279015693615134

# Lịch chạy cronjob: 0 12 * * * nghĩa là đúng 12h00 trưa mỗi ngày
# Nếu chỉ muốn chạy từ Thứ 2 đến Thứ 6 thì đổi thành: 0 12 * * 1-5
CRON_SCHEDULE=0 12 * * *
# Server ID (Guild ID)
GUILD_ID=1504851139005517995

# Lịch chạy cronjob: 0 1 * * * nghĩa là đúng 01h00 sáng mỗi ngày
# Nếu chỉ muốn chạy từ Thứ 2 đến Thứ 6 thì đổi thành: 0 1 * * 1-5
CRON_SCHEDULE=0 1 * * *

# Timezone Việt Nam
TIMEZONE=Asia/Ho_Chi_Minh

# Lịch chạy nhắc nhở Báo cáo tuần (Weekly Report): 0 9 * * 6 (09h00 sáng Thứ 7 hàng tuần)
WEEKLY_REPORT_CRON=0 9 * * 6

# Danh sách tài khoản / tên cần loại trừ không tag (ngăn cách bằng dấu phẩy)
# Mặc định code đã tự động loại trừ: longnx, Lê Trường Thành (và các biến thể truongthanh)
EXCLUDED_USERS=longnx,truongthanh,trường thành,lê trường thành

# ============================================================
# Cấu hình Giám sát Sức khỏe Server & Phân tích Alert Tự động
# (Hạ tầng WDP301 - Cloudflare WAF & Nginx Reverse Proxy)
# ============================================================
GRAFANA_URL=https://abcpharmacy.store/grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
API_GATEWAY_URL=https://abcpharmacy.store/api/medicines
WEB_HEALTH_URL=https://abcpharmacy.store
DOZZLE_URL=https://abcpharmacy.store/dozzle



